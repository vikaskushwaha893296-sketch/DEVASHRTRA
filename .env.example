# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV=development

# DATABASE CONFIGURATION
# MongoDB connection string (e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/devashtra?retryWrites=true&w=majority)
# If omitted or offline, Devashtra runs with the built-in resilient in-memory storage fallback.
MONGODB_URI="mongodb://localhost:27017/devashtra"

# AUTHENTICATION
JWT_SECRET="devashtra_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# CODE EXECUTION (Judge0 or RapidAPI Judge0)
# Optional in Phase 1; configured for Phase 3
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
